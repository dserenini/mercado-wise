<%- include("partials/top", { title: "Entrar", hideNav: true }) %>
<article class="narrow">
  <h1 class="login-brand"><%- include("partials/logo") %> mercado-wise</h1>
  <form method="post" action="/login">
    <label>
      Usuário
      <input name="username" value="<%= username %>" autocomplete="username" autocapitalize="none"
        spellcheck="false" required <%= username ? "" : "autofocus" %>
        <% if (error) { %>aria-invalid="true"<% } %>>
    </label>
    <label>
      Senha
      <input type="password" name="password" autocomplete="current-password" required
        <%= username ? "autofocus" : "" %> <% if (error) { %>aria-invalid="true" aria-describedby="login-error"<% } %>>
      <% if (error) { %><small id="login-error"><%= error %></small><% } %>
    </label>
    <button type="submit">Entrar</button>
  </form>
</article>
<%- include("partials/bottom") %>
