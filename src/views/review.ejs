<%- include("partials/top", { title: receipt.store_name || "Nota" }) %>
<%
  const r = receipt;
  const SOURCE = { memory: "memória", ai: "IA", user: "você" };
  const STATUS = { ok: "✓", warning: "!", error: "✗" };
  // Faltou o básico (produto ou preço): vai para o topo, para corrigir primeiro. Os
  // itens começam fechados; a cor e o ícone mostram quem tem problema.
  const missing = (it) =>
    it.product === null || it.quantity === null || it.unit_price_cents === null ||
    it.total_price_cents === null;
  const toFix = items.map((it, i) => [it, i]).filter(([it]) => missing(it));
%>

<a href="<%= back %>" class="back-link">← Notas</a>

<hgroup>
  <h1><%= r.store_name || "Mercado não identificado" %></h1>
  <p class="owner-line"><%- include("partials/owner", { receipt: r }) %>
    <% if (r.source === "qrcode") { %><small class="muted">· lida pela página oficial da SEFAZ (QR Code)</small><% } %></p>
  <p>
    <% if (r.status !== "confirmed") { %>
      Revise e confirme. <%- include("partials/light", { light: r.traffic_light }) %>
    <% } else { %>
      Nota confirmada<%= r.confirmed_at ? " em " + r.confirmed_at.toLocaleDateString("pt-BR") : "" %>. Você pode corrigir e salvar de novo.
    <% } %>
  </p>
</hgroup>

<% if (r.status === "duplicate") { %>
  <div class="duplicate-box">
    <strong>Possível nota repetida</strong> da
    <a href="/receipts/<%= r.duplicate_of %>">nota #<%= r.duplicate_of %></a>:
    <%= r.duplicate_reason %>.
    <div class="duplicate-actions">
      <form method="post" action="/receipts/<%= r.id %>/delete" class="inline"
            onsubmit="return confirm('Excluir esta nota (a repetida)?')">
        <button type="submit" class="secondary outline danger">Excluir esta (é repetida)</button>
      </form>
      <form method="post" action="/receipts/<%= r.id %>/not-duplicate" class="inline">
        <button type="submit" class="secondary outline">Não é repetida</button>
      </form>
    </div>
  </div>
<% } %>

<% if (errors.length > 0) { %>
  <div class="error-box">
    <strong>Não deu para salvar:</strong>
    <ul><% for (const e of errors) { %><li><%= e %></li><% } %></ul>
    <small>Os campos voltaram como estavam no banco; ajuste e tente de novo.</small>
  </div>
<% } %>

<% if (r.has_image) { %>
  <%- include("partials/photos", { r, closeUps, summary: "Ver foto da nota" }) %>
<% } %>

<form method="post" action="/receipts/<%= r.id %>/confirm" id="review-form" data-cnpj="<%= r.store_cnpj || "" %>">
  <article>
    <div class="grid">
      <label>Mercado
        <input name="store_name" value="<%= r.store_name || "" %>" list="stores" autocomplete="off">
        <datalist id="stores">
          <% for (const name of stores) { %><option value="<%= name %>"></option><% } %>
        </datalist>
      </label>
      <label>Data
        <input type="date" name="purchase_date" value="<%= r.purchase_date || "" %>">
      </label>
    </div>
    <div class="grid">
      <label>Total da nota (R$)
        <input name="total" inputmode="decimal" value="<%= centsToInput(r.total_cents) %>" data-total>
      </label>
      <label>Pagamento
        <input name="payment_method" value="<%= r.payment_method || "" %>">
      </label>
    </div>
    <small class="muted">
      CNPJ <%= r.store_cnpj || "—" %>
      <% if (/^\d{14}$/.test(r.store_cnpj || "")) { %> · <a href="/stores/<%= r.store_cnpj %>">ver mercado</a><% } %>
      <% if (r.purchase_time) { %> · <%= r.purchase_time %><% } %>
      <% if (r.access_key) { %><br>Chave <%= r.access_key.replace(/(\d{4})/g, "$1 ").trim() %><% } %>
    </small>
  </article>

  <%# Sugestões do campo "Na nota", preenchidas pelo review.js conforme a digitação. %>
  <datalist id="item-suggestions"></datalist>

  <div class="items-toggle">
    <button type="button" class="secondary outline" data-open-all="1">Expandir todos</button>
    <button type="button" class="secondary outline" data-open-all="">Recolher todos</button>
  </div>

  <%# A ordem salva vem da chave (items[i]), não da posição na tela: os itens do
      topo voltam ao lugar deles na nota ao salvar. %>
  <div id="items">
    <% if (toFix.length > 0) { %>
      <section class="to-fix" data-to-fix>
        <h2>Faltou informação (<span data-to-fix-count><%= toFix.length %></span>)</h2>
        <p class="muted"><small>A leitura não achou o preço ou o produto destes itens. Confira na foto e preencha.</small></p>
        <% for (const [it, i] of toFix) { %>
          <%- include("partials/item", { key: i, it, open: false, SOURCE, STATUS }) %>
        <% } %>
      </section>
      <h2 class="items-heading">Itens da nota</h2>
    <% } %>
    <% items.forEach((it, i) => { if (!missing(it)) { %>
      <%- include("partials/item", { key: i, it, open: false, SOURCE, STATUS }) %>
    <% } }) %>
  </div>

  <template id="new-item">
    <%- include("partials/item", { key: "__KEY__", it: null, open: true, SOURCE, STATUS }) %>
  </template>

  <button type="button" class="secondary outline" id="add-item">+ Adicionar item</button>

  <%# Desconto que a nota traz só no total (a página da SEFAZ não detalha por item):
      entra na soma, além dos descontos dos itens. %>
  <div class="totals-bar" id="totals" aria-live="polite" data-discount-total="<%= r.discount_total_cents || 0 %>">
    <span data-extra-wrap hidden>Desconto no total <strong data-extra>—</strong></span>
    <span>Soma <strong data-sum>—</strong></span>
    <span>Nota <strong data-printed>—</strong></span>
    <span data-diff-wrap>Diferença <strong data-diff>—</strong></span>
  </div>

  <div class="review-actions">
    <button type="submit"><%= r.status === "confirmed" ? "Salvar correções" : "Confirmar nota" %></button>
    <% if (r.status !== "confirmed") { %>
      <%# O rascunho já está salvo: dá para sair e revisar depois. %>
      <a href="<%= back %>" role="button" class="secondary outline">Revisar depois</a>
    <% } %>
  </div>
</form>

<form method="post" action="/receipts/<%= r.id %>/delete"
      onsubmit="return confirm('Excluir esta nota? Não dá para desfazer.')">
  <button type="submit" class="secondary outline danger">Excluir nota</button>
</form>

<script src="/static/review.js?v=<%= assetVersion %>" defer></script>
<%- include("partials/bottom") %>
