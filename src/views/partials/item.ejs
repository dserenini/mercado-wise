<%#
  Um item da nota, editável. `it` é null no modelo de item novo (template).
  Os nomes items[KEY][campo] viram um array/objeto no servidor (review-form.ts).
  Layout compacto: grade de 12 colunas no computador, 4 no celular (classes d-N / m-N).
%>
<%
  const v = (field) => (it && it[field] !== null && it[field] !== undefined ? it[field] : "");
  const name = (field) => `items[${key}][${field}]`;
  const summary = it
    ? (it.product ? [it.product, it.brand, it.variant].filter(Boolean).join(" · ") : "sem interpretação")
    : "Item novo";
  const qty = it && it.quantity !== null ? decimalToInput(it.quantity) : "?";
  const total = it && it.total_price_cents !== null ? formatCents(it.total_price_cents) : "?";
%>
<details class="item status-<%= it ? (it.check_status || "none") : "new" %>" data-item <%= open ? "open" : "" %>>
  <summary>
    <span class="item-status"><%= it && it.check_status ? STATUS[it.check_status] : "+" %></span>
    <span class="item-title">
      <strong><%= summary %></strong>
      <small><%= it ? (it.raw_description || "descrição ilegível") : "" %><% if (it && it.interpretation_source) { %> · <%= SOURCE[it.interpretation_source] || it.interpretation_source %><% } %></small>
    </span>
    <span class="item-total"><small><%= qty %> ×</small> <%= total %></span>
  </summary>

  <% if (it && (it.check_problems.length > 0 || (it.interpretation_source && it.confidence !== "high"))) { %>
    <ul class="problems">
      <% for (const p of it.check_problems) { %>
        <li class="<%= p.severity %>"><%= p.message %></li>
      <% } %>
      <% if (it.interpretation_source && it.confidence && it.confidence !== "high") { %>
        <li class="warning">Interpretação (<%= SOURCE[it.interpretation_source] || it.interpretation_source %>) com confiança <%= it.confidence === "low" ? "baixa" : "média" %>: confira o produto.</li>
      <% } %>
    </ul>
  <% } %>

  <div class="fields">
    <label class="d-6 m-4">Na nota
      <input name="<%= name("raw_description") %>" value="<%= v("raw_description") %>">
    </label>
    <label class="d-3 m-2">EAN
      <input name="<%= name("ean") %>" value="<%= v("ean") %>" inputmode="numeric" pattern="\d*">
    </label>
    <label class="d-3 m-2">Código interno
      <input name="<%= name("store_code") %>" value="<%= v("store_code") %>">
    </label>

    <label class="d-2 m-1">Qtd
      <input name="<%= name("quantity") %>" value="<%= it ? decimalToInput(it.quantity) : "" %>" inputmode="decimal" data-qty>
    </label>
    <label class="d-2 m-1">Un
      <input name="<%= name("unit") %>" value="<%= v("unit") %>">
    </label>
    <label class="d-3 m-1">Preço un.
      <input name="<%= name("unit_price") %>" value="<%= it ? centsToInput(it.unit_price_cents) : "" %>" inputmode="decimal" data-price>
    </label>
    <label class="d-3 m-1">Total
      <input name="<%= name("total_price") %>" value="<%= it ? centsToInput(it.total_price_cents) : "" %>" inputmode="decimal" data-line-total>
    </label>
    <label class="d-2 m-4">Desconto
      <input name="<%= name("discount") %>" value="<%= it ? centsToInput(it.discount_cents) : "" %>" inputmode="decimal" data-discount>
    </label>

    <label class="d-4 m-4">Produto
      <input name="<%= name("product") %>" value="<%= v("product") %>" required>
    </label>
    <label class="d-3 m-2">Marca
      <input name="<%= name("brand") %>" value="<%= v("brand") %>">
    </label>
    <label class="d-5 m-2">Variante
      <input name="<%= name("variant") %>" value="<%= v("variant") %>">
    </label>

    <label class="d-4 m-2">Categoria
      <select name="<%= name("category") %>" required>
        <option value="">—</option>
        <% for (const c of CATEGORIES) { %>
          <option <%= v("category") === c ? "selected" : "" %>><%= c %></option>
        <% } %>
      </select>
    </label>
    <label class="d-2 m-1">Embalagem
      <input name="<%= name("package_size") %>" value="<%= it ? decimalToInput(it.package_size) : "" %>" inputmode="decimal">
    </label>
    <label class="d-2 m-1">Unid.
      <select name="<%= name("package_unit") %>">
        <option value="">—</option>
        <% for (const u of ["g", "kg", "ml", "l", "un"]) { %>
          <option <%= v("package_unit") === u ? "selected" : "" %>><%= u %></option>
        <% } %>
      </select>
    </label>
    <div class="d-4 m-4 field-actions">
      <button type="button" class="secondary outline danger" data-remove>Remover item</button>
    </div>
  </div>
</details>
