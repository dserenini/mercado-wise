<%- include("partials/top", { title: "Configurações" }) %>
<h1>Configurações</h1>
<% if (!settings.ready) { %><p class="error-box" role="alert">O banco ainda não tem a tabela de configurações (rode <code>npm run migrate</code>). Até lá, o app usa as variáveis de ambiente, mostradas abaixo, e nada pode ser salvo aqui.</p><% } %>
<% if (saved) { %><p class="flash" role="status">Configurações salvas. Valem para a próxima nota enviada.</p><% } %>

<form method="post" action="/settings" class="settings">
  <fieldset>
    <legend><strong>IA que lê e interpreta as notas</strong></legend>
    <% for (const p of PROVIDERS) { %>
      <label>
        <input type="radio" name="provider" value="<%= p %>" <%= settings.provider === p ? "checked" : "" %>>
        <%= PROVIDER_LABEL[p] %>
      </label>
    <% } %>
  </fieldset>

  <% for (const p of PROVIDERS) { const s = settings.providers[p]; %>
    <article>
      <h2><%= PROVIDER_LABEL[p] %></h2>

      <label for="<%= p %>_key">Chave da API</label>
      <input id="<%= p %>_key" name="<%= p %>_key" type="password" autocomplete="off"
        placeholder="<%= s.keyHint ? "Deixe vazio para manter a atual" : "Cole a chave aqui" %>"
        aria-describedby="<%= p %>_key_help">
      <small id="<%= p %>_key_help">
        <% if (s.keySource === "saved") { %>Chave salva aqui (termina em <%= s.keyHint %>).
        <% } else if (s.keySource === "env") { %>Usando a chave do .env (termina em <%= s.keyHint %>). Uma chave salva aqui passa a valer no lugar dela.
        <% } else { %>Nenhuma chave cadastrada.<% } %>
      </small>
      <% if (s.keySource === "saved") { %>
        <label>
          <input type="checkbox" name="<%= p %>_clear_key" value="1">
          Apagar a chave salva
        </label>
      <% } %>

      <div class="grid">
        <label>Modelo da leitura (foto)
          <input name="<%= p %>_reader_model" value="<%= s.readerModel %>" autocomplete="off" spellcheck="false">
        </label>
        <label>Modelo da interpretação (texto)
          <input name="<%= p %>_interpreter_model" value="<%= s.interpreterModel %>" autocomplete="off" spellcheck="false">
        </label>
      </div>
      <small class="muted">Deixe um modelo vazio para voltar ao padrão.</small>
      <p class="test-row">
        <button type="button" class="secondary outline" data-test="<%= p %>">Testar chave e modelos</button>
        <span role="status" aria-live="polite" data-test-result="<%= p %>"></span>
      </p>
    </article>
  <% } %>

  <button type="submit" <%= settings.ready ? "" : "disabled" %>>Salvar</button>
</form>
<script>
  // Testar: manda a chave digitada (ou nenhuma, para usar a atual) e os modelos do
  // formulário; não salva.
  for (const button of document.querySelectorAll("[data-test]")) {
    button.addEventListener("click", async () => {
      const p = button.dataset.test;
      const out = document.querySelector(`[data-test-result="${p}"]`);
      const form = button.form;
      const body = new URLSearchParams({
        provider: p,
        key: form.elements[`${p}_key`].value,
        reader_model: form.elements[`${p}_reader_model`].value,
        interpreter_model: form.elements[`${p}_interpreter_model`].value,
      });
      button.setAttribute("aria-busy", "true");
      out.textContent = "Testando…";
      out.className = "";
      try {
        const res = await fetch("/settings/test", { method: "POST", body });
        const r = await res.json();
        out.textContent = r.message;
        out.className = r.ok ? "test-ok" : "test-bad";
      } catch {
        out.textContent = "Sem resposta do servidor.";
        out.className = "test-bad";
      } finally {
        button.removeAttribute("aria-busy");
      }
    });
  }
</script>
<%- include("partials/bottom") %>
