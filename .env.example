# Copie para .env e preencha. O .env fica fora do git.

# Chave da API da Anthropic (console.anthropic.com → API Keys).
# Alternativa: `ant auth login`, que o SDK também reconhece.
ANTHROPIC_API_KEY=

# Modelo e esforço da etapa LER (a Fase 4 compara modelos com dados).
READER_MODEL=claude-sonnet-5-5
READER_EFFORT=high

PORT=3000

# Modelo e esforço da etapa INTERPRETAR (texto, um lote por nota).
INTERPRETER_MODEL=claude-sonnet-5-5
INTERPRETER_EFFORT=high

# Postgres do Supabase: botão "Connect" → Transaction pooler (porta 6543), com a senha.
DATABASE_URL=

# Login do app: rode `npm run setup-login` e cole as duas linhas que ele imprimir.
APP_PASSWORD_HASH=
SESSION_SECRET=

# Opcional: usar a OpenAI no lugar do Claude. Descomente as quatro linhas: os
# modelos daqui valem no lugar dos do Claude acima (o esforço vira reasoning_effort).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# READER_MODEL=gpt-5.6-terra
# INTERPRETER_MODEL=gpt-5.6-luna
