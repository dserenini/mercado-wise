# ─── Copie para .env e preencha. NUNCA versione o .env real. ───

# ── PÚBLICO (frontend Vite + validação de token no backend) ──
# Seguras para ir ao bundle do cliente.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=seu_project_id
# URL do backend Python (OCR/scrape/normalize)
VITE_API_URL=http://localhost:8000

# ── SEGREDOS (somente backend — NUNCA no frontend) ──
# Chave mestra: bypass de RLS, usada só para tabelas globais (product_dictionary).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...
# API do Gemini para normalização de produtos.
GEMINI_API_KEY=AIza...

# ── CONFIG DO BACKEND (opcionais — têm defaults) ──
# Origens permitidas no CORS (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:8080
# Domínios oficiais da Sefaz aceitos pelo scraper (anti-SSRF).
ALLOWED_SEFAZ_DOMAINS=fazenda.mg.gov.br,sefaz.mg.gov.br
# Tamanho máximo de upload de imagem, em MB.
MAX_UPLOAD_MB=10
