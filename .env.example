# Copie para .env e preencha. O .env fica fora do git.

# Chave da API da Anthropic (console.anthropic.com → API Keys).
# Alternativa: `ant auth login`, que o SDK também reconhece.
ANTHROPIC_API_KEY=

# Modelo e esforço da etapa LER (a Fase 4 compara modelos com dados).
READER_MODEL=claude-sonnet-5-5
READER_EFFORT=high

PORT=3000

# Modelo e esforço da etapa INTERPRETAR (texto, um lote por nota).
INTERPRETER_MODEL=claude-sonnet-5-5
INTERPRETER_EFFORT=high
